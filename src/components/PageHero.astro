---
// Opening of every interior page: label, title rising through its mask line by line, a metallic
// hairline drawing across, a short intro. CSS only; it waits for the page curtain when the page
// was reached through a transition (html.tx-cover).
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---
<header class="page-hero">
  <p class="eyebrow ph-eyebrow">{eyebrow}</p>
  <h1 class="ph-title"><span class="ph-mask"><span class="ph-in">{title}</span></span></h1>
  <span class="rule ph-rule" aria-hidden="true"></span>
  {intro && <p class="ph-intro">{intro}</p>}
  <slot />
</header>

<style>
  .page-hero { display: grid; gap: 26px; padding-bottom: 56px; margin-bottom: 64px; }
  .ph-title { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(44px, 6.6vw, 112px); line-height: .98; letter-spacing: -.045em; max-width: 18ch; }
  .ph-mask { display: block; overflow: hidden; padding-bottom: .1em; margin-bottom: -.1em; }
  .ph-in { display: block; animation: ph-rise 1.2s var(--ease-out) both .15s; }
  .ph-eyebrow { animation: ph-fade .9s var(--ease-out) both .05s; }
  .ph-rule { transform-origin: left; animation: ph-draw 1.4s var(--ease-cine) both .35s; }
  .ph-intro { margin: 0; max-width: 54ch; font-size: clamp(17px, 1.35vw, 20px); color: var(--color-muted-foreground); animation: ph-fade 1s var(--ease-out) both .55s; }
  :global(html.tx-cover) .ph-in, :global(html.tx-cover) .ph-rule, :global(html.tx-cover) .ph-intro, :global(html.tx-cover) .ph-eyebrow { animation-delay: .75s; }
  @keyframes ph-rise { from { transform: translateY(108%); } to { transform: none; } }
  @keyframes ph-draw { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes ph-fade { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
</style>
