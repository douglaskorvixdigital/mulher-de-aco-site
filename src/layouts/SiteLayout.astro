---
// Site chrome. Kit contract kept: the seo-tags slot, the global.css import, one CartButton in the
// header and one CartDrawer per page (both client:only), shop category links from the live tree.
import CartButton from "../components/storefront/CartButton";
import CartDrawer from "../components/storefront/CartDrawer";
import { fetchCategories } from "../wix/storefront/catalog";
import type { Category } from "../wix/storefront/types";
import "../styles/global.css";
// (perf) the display face sets every page's first headline: fetch it with the HTML
import displayFont from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  /** Pages that build their own full-bleed opening skip the top padding. */
  bleed?: boolean;
}
const { title, description, bleed = false } = Astro.props;

const NAV = [
  { href: "/magazine", label: "A Revista", note: "Edições e The Power of M" },
  { href: "/blog", label: "Reportagens", note: "Histórias por editoria" },
  { href: "/women-of-steel", label: "Mulheres de Aço", note: "Perfis e trajetórias" },
  { href: "/about", label: "Quem somos", note: "Missão e valores" },
  { href: "/events", label: "Eventos", note: "Encontros da revista" },
  { href: "/shop", label: "Loja", note: "Edições e livros" },
  { href: "/partnerships", label: "Parcerias", note: "Anuncie na revista" },
];
const MORE = [
  { href: "/about-the-founder", label: "A fundadora" },
  { href: "/share-your-story", label: "Envie sua história" },
  { href: "/contact", label: "Contato" },
];

let shopCategories: Category[] = [];
try {
  shopCategories = (await fetchCategories()).filter((c) => c.parentId === null);
} catch {
  /* the shop link still reaches everything */
}
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href + "/");
const forwarded = Astro.request.headers.get("x-wix-forwarded-url");
const origin = forwarded && URL.canParse(forwarded) ? new URL(forwarded).origin.replace(/^http:/, "https:") : Astro.url.origin;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#06122B" />
    <script is:inline>
      // a page reached through a transition opens under the curtain, so it never flashes
      try { if (sessionStorage.getItem("mda-tx") && !matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("tx-cover"); } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    {title && !Astro.slots.has("seo-tags") && <title>{title} · A Mulher de Aço</title>}
    {description && <meta name="description" content={description} />}
    <meta property="og:site_name" content="A Mulher de Aço" />
    {title && <meta property="og:title" content={`${title} · A Mulher de Aço`} />}
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={`${origin}/images/edicao-01-capa.webp`} />
    <slot name="seo-tags" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip">Pular para o conteúdo</a>

    <header class="site-top gutter" data-top>
      <a class="mark" href="/" aria-label="A Mulher de Aço, início">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><defs><linearGradient id="mk" x1="0" x2="1"><stop offset="0" stop-color="#8A6A22"/><stop offset=".5" stop-color="#FFF0C2"/><stop offset="1" stop-color="#B8913A"/></linearGradient></defs><g stroke="url(#mk)" stroke-width="1.1"><circle cx="12" cy="12" r="10"/><ellipse cx="12" cy="12" rx="4.2" ry="10"/><path d="M2 12h20M4 7h16M4 17h16"/></g></svg>
        <span class="mark-word">A Mulher <span>de Aço</span></span>
      </a>
      <nav class="nav-main" aria-label="Principal">
        {NAV.map((item) => (
          <a href={item.href} class="link-draw" aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
      <div class="top-actions">
        <span class="label lang" title="Inglês em breve">PT <span aria-hidden="true">/</span> <span class="dim">EN</span></span>
        <CartButton client:only="react" />
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-panel">
          <span class="menu-lines" aria-hidden="true"><i></i><i></i></span>
          <span class="label menu-label">Menu</span>
        </button>
      </div>
    </header>

    <div id="menu-panel" class="menu-panel" hidden>
      <span class="menu-rule rule" aria-hidden="true"></span>
      <div class="menu-grid gutter">
        <nav aria-label="Menu" class="menu-list">
          {NAV.map((item, i) => (
            <a href={item.href} style={`--i:${i}`} aria-current={isCurrent(item.href) ? "page" : undefined}>
              <span class="numeral menu-n">{String(i + 1).padStart(2, "0")}</span>
              <span class="menu-t">{item.label}</span>
              <span class="menu-note">{item.note}</span>
            </a>
          ))}
        </nav>
        <aside class="menu-side" style={`--i:${NAV.length}`}>
          <p class="eyebrow">Também</p>
          {MORE.map((m) => <a href={m.href} class="link-draw">{m.label}</a>)}
          <p class="eyebrow menu-contact">Redação</p>
          <p class="select-all">editorial@amulherdeaco.com</p>
          <p class="select-all">+1 203-297-5498</p>
        </aside>
      </div>
    </div>

    <main id="main" class:list={["site-main", { "gutter page-pad": !bleed }]}>
      <slot />
    </main>

    <footer class="site-foot">
      <span class="rule" aria-hidden="true"></span>
      <div class="gutter f-inner">
        <div class="f-brand">
          <p class="f-word">A Mulher de Aço</p>
          <p class="f-tag">The Woman of Steel · Beyond Borders, Beyond Limits</p>
          <a class="btn btn-line f-cta" href="/partnerships">Anuncie na revista <span class="arr" aria-hidden="true">→</span></a>
        </div>
        <nav aria-label="Rodapé" class="f-col">
          <p class="eyebrow">Navegue</p>
          {NAV.map((item) => <a href={item.href} class="link-draw">{item.label}</a>)}
        </nav>
        <div class="f-col">
          <p class="eyebrow">Participe</p>
          {MORE.map((item) => <a href={item.href} class="link-draw">{item.label}</a>)}
          {shopCategories.map((c) => <a href={`/category/${c.slug}`} class="link-draw">Loja · {c.name}</a>)}
        </div>
        <div class="f-col">
          <p class="eyebrow">Redação</p>
          <p class="select-all">editorial@amulherdeaco.com</p>
          <p class="select-all">amulherdeaco@gmail.com</p>
          <p class="select-all">+1 203-297-5498</p>
        </div>
      </div>
      <p class="gutter label f-legal">© {new Date().getFullYear()} A Mulher de Aço</p>
    </footer>

    <div id="tx" aria-hidden="true"><div class="tx-panel"></div><div class="tx-line"></div></div>
    <CartDrawer client:only="react" />

    <style is:global>
      .skip { position: absolute; left: -9999px; }
      .skip:focus { left: 16px; top: 16px; z-index: 100; background: var(--color-gold); color: var(--color-navy); padding: 10px 16px; }

      /* header: transparent over the opening, navy glass once the page moves */
      .site-top { position: fixed; top: env(safe-area-inset-top, 0px); left: 0; right: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 76px; color: var(--color-white); transition: background-color var(--t-std) var(--ease-out), height var(--t-std) var(--ease-out), border-color var(--t-std) var(--ease-out); border-bottom: 1px solid transparent; }
      .site-top.scrolled { background: rgba(6, 18, 43, .86); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); height: 64px; border-bottom-color: rgba(215, 181, 101, .18); }
      body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 51; background: var(--color-navy); }
      .mark { display: flex; align-items: center; gap: 12px; text-decoration: none; white-space: nowrap; }
      .mark svg { width: 24px; height: 24px; transition: transform 1.4s var(--ease-out); }
      .mark:hover svg { transform: rotate(180deg); }
      .mark-word { font-family: var(--font-display); font-weight: 600; font-size: 17px; letter-spacing: -.01em; }
      .mark-word span { font-weight: 300; }
      .nav-main { display: flex; gap: 26px; font-size: 14px; }
      .top-actions { display: flex; align-items: center; gap: 18px; }
      .lang .dim { color: var(--color-mist); }
      .menu-btn { display: none; align-items: center; gap: 12px; background: none; border: 0; color: inherit; cursor: pointer; padding: 10px 0; }
      .menu-lines { position: relative; width: 26px; height: 10px; }
      .menu-lines i { position: absolute; left: 0; right: 0; height: 1px; background: var(--gold-metal); transition: transform var(--t-std) var(--ease-cine), top var(--t-std) var(--ease-cine); }
      .menu-lines i:first-child { top: 0; } .menu-lines i:last-child { top: 9px; }
      .menu-btn[aria-expanded="true"] .menu-lines i:first-child { top: 4.5px; transform: rotate(45deg); }
      .menu-btn[aria-expanded="true"] .menu-lines i:last-child { top: 4.5px; transform: rotate(-45deg); }
      @media (max-width: 1180px) { .nav-main, .lang { display: none; } .menu-btn { display: inline-flex; } }

      /* menu as an experience: a navy curtain falls, a gold line runs across, items rise one by one */
      .menu-panel { position: fixed; inset: 0; z-index: 45; background: var(--color-navy); overflow-y: auto; padding-top: calc(env(safe-area-inset-top, 0px) + 110px); padding-bottom: 48px; clip-path: inset(0 0 100% 0); transition: clip-path 760ms var(--ease-cine); }
      .menu-panel.open { clip-path: inset(0 0 0 0); }
      .menu-rule { position: absolute; left: 0; right: 0; top: 76px; transform: scaleX(0); transform-origin: left; transition: transform 900ms var(--ease-cine) 200ms; }
      .menu-panel.open .menu-rule { transform: scaleX(1); }
      .menu-grid { display: grid; grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr); gap: 6vw; }
      .menu-list { display: grid; }
      .menu-list a { display: grid; grid-template-columns: 56px 1fr auto; align-items: baseline; gap: 16px; padding-block: 14px; border-bottom: 1px solid var(--color-border); text-decoration: none; opacity: 0; transform: translateY(26px); transition: opacity 600ms var(--ease-out), transform 800ms var(--ease-out); transition-delay: calc(180ms + var(--i) * 55ms); }
      .menu-panel.open .menu-list a, .menu-panel.open .menu-side { opacity: 1; transform: none; }
      .menu-n { color: var(--color-gold); font-size: 22px; }
      .menu-t { font-family: var(--font-display); font-weight: 500; font-size: clamp(30px, 4.4vw, 60px); letter-spacing: -.035em; line-height: 1.05; transition: transform var(--t-std) var(--ease-out), color var(--t-std) var(--ease-out); }
      .menu-list a:hover .menu-t, .menu-list a:focus-visible .menu-t { transform: translateX(14px); color: var(--color-gold-light); }
      .menu-list a[aria-current="page"] .menu-t { color: var(--color-gold); }
      .menu-note { color: var(--color-mist); font-size: 14px; }
      .menu-side { display: flex; flex-direction: column; gap: 10px; align-self: end; opacity: 0; transform: translateY(26px); transition: opacity 600ms var(--ease-out), transform 800ms var(--ease-out); transition-delay: calc(180ms + var(--i) * 55ms); }
      .menu-side a { text-decoration: none; color: var(--color-white); align-self: flex-start; }
      .menu-contact { margin-top: 18px; }
      @media (max-width: 760px) { .menu-grid { grid-template-columns: 1fr; } .menu-list a { grid-template-columns: 40px 1fr; } .menu-note { display: none; } .menu-n { font-size: 18px; } }

      .page-pad { padding-top: calc(env(safe-area-inset-top, 0px) + 150px); padding-bottom: 120px; }

      /* footer */
      .site-foot { background: var(--color-navy); color: var(--color-white); }
      .f-inner { display: grid; grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr)); gap: 40px; padding-block: 72px 48px; }
      .f-brand { display: grid; gap: 16px; align-content: start; }
      .f-word { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(36px, 4vw, 60px); letter-spacing: -.04em; line-height: 1; }
      .f-tag { margin: 0; color: var(--color-mist); }
      .f-cta { justify-self: start; margin-top: 8px; }
      .f-col { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; min-width: 0; }
      .f-col a { text-decoration: none; color: var(--color-mist); }
      .f-col a:hover { color: var(--color-white); }
      .f-col p:not(.eyebrow) { margin: 0; color: var(--color-mist); }
      .f-legal { color: var(--color-mist); padding-bottom: 32px; }
      @media (max-width: 900px) { .f-inner { grid-template-columns: 1fr 1fr; } .f-brand { grid-column: 1 / -1; } }
      @media (max-width: 520px) { .f-inner { grid-template-columns: 1fr; } }

      /* transition layer */
      #tx { position: fixed; inset: 0; z-index: 90; pointer-events: none; display: none; }
      #tx.on, html.tx-cover #tx { display: block; }
      .tx-panel { position: absolute; inset: 0; background: var(--color-navy); }
      html.tx-cover .tx-panel { clip-path: inset(0 0 0 0); }
      .tx-line { position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: var(--gold-metal); transform-origin: left; transform: scaleX(0); box-shadow: 0 0 18px rgba(243, 222, 159, .45); }
      .tx-ghost { position: fixed; object-fit: cover; z-index: 1; }
    </style>

    <script>
      import "../scripts/transitions";

      // header turns to navy glass once the page has moved
      const top = document.querySelector<HTMLElement>("[data-top]");
      const onScroll = () => top?.classList.toggle("scrolled", scrollY > 30);
      addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      // menu
      const btn = document.querySelector<HTMLButtonElement>(".menu-btn");
      const panel = document.getElementById("menu-panel");
      const label = btn?.querySelector(".menu-label");
      const setOpen = (open: boolean) => {
        if (!btn || !panel) return;
        btn.setAttribute("aria-expanded", String(open));
        if (label) label.textContent = open ? "Fechar" : "Menu";
        document.documentElement.style.overflow = open ? "hidden" : "";
        if (open) {
          panel.hidden = false;
          requestAnimationFrame(() => requestAnimationFrame(() => panel.classList.add("open")));
          panel.querySelector<HTMLElement>("a")?.focus({ preventScroll: true });
        } else {
          panel.classList.remove("open");
          const done = () => { panel.hidden = true; panel.removeEventListener("transitionend", done); };
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) done();
          else panel.addEventListener("transitionend", done);
          btn.focus({ preventScroll: true });
        }
      };
      btn?.addEventListener("click", () => setOpen(btn.getAttribute("aria-expanded") !== "true"));
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && btn?.getAttribute("aria-expanded") === "true") setOpen(false); });
      // returning with the back button must not restore an open menu over the page
      addEventListener("pageshow", (e) => { if (e.persisted && btn?.getAttribute("aria-expanded") === "true") setOpen(false); });
    </script>
  </body>
</html>
