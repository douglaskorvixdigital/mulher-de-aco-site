---
// About the founder — she appears as origin and editorial signature, never as the product.
// Every line about her needs her approval: until then this page shows visible placeholders only.
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="A fundadora" description="A origem de A Mulher de Aço / The Woman of Steel">
  <article class="flex max-w-3xl flex-col gap-6">
    <p class="eyebrow">A fundadora</p>
    <h1 class="display text-[clamp(40px,6vw,88px)] font-extrabold leading-[.9]">Nasce da história de uma mulher</h1>
    <div class="aspect-[4/3] w-full rounded-lg bg-secondary" aria-hidden="true"></div>
    <p class="rounded-lg border border-dashed border-border p-4 text-muted-foreground">[Texto provisório] Carta e biografia da fundadora aguardando aprovação. Nada sobre a fundadora é publicado sem a aprovação dela.</p>
    <a href="/magazine" class="self-start rounded-control bg-primary px-6 py-3 font-medium text-primary-foreground no-underline">Ler a revista</a>
  </article>
</SiteLayout>
