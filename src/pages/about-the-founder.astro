---
// About the founder — she appears as origin and editorial signature, never as the product.
// Every line about her needs her approval: until then this page shows visible placeholders only.
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="About the Founder" description="The origin of A Mulher de Aço / The Woman of Steel">
  <article class="flex max-w-3xl flex-col gap-6">
    <p class="eyebrow">About the Founder</p>
    <h1 class="font-serif text-4xl font-semibold">Born from one woman's story, made for the stories of many women</h1>
    <div class="aspect-[4/3] w-full rounded-lg bg-secondary" aria-hidden="true"></div>
    <p class="rounded-lg border border-dashed border-border p-4 text-muted-foreground">[Placeholder] Founder's letter and biography pending approval. Nothing about the founder is published without her approval.</p>
    <a href="/magazine" class="self-start rounded-control bg-primary px-6 py-3 font-medium text-primary-foreground no-underline">Read the magazine</a>
  </article>
</SiteLayout>
