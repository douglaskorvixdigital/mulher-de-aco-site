---
// About the founder — she appears as origin and editorial signature, never as the product.
// Every line about her needs her approval: until then this page shows visible placeholders only.
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="A fundadora" description="A origem de A Mulher de Aço / The Woman of Steel">
  <article class="flex max-w-3xl flex-col gap-6">
    <p class="eyebrow">A fundadora</p>
    <h1 class="font-[family-name:var(--font-display)] text-[clamp(40px,5.4vw,88px)] font-medium leading-none tracking-[-.045em]">Nasce da história de uma mulher</h1>
    <div class="aspect-[4/3] w-full border border-border bg-secondary" aria-hidden="true"></div>
    <p class="border border-dashed border-border p-4 text-muted-foreground">[Texto provisório] Carta e biografia da fundadora aguardando aprovação. Nada sobre a fundadora é publicado sem a aprovação dela.</p>
    <a href="/magazine" class="btn btn-gold self-start">Ler a revista <span class="arr" aria-hidden="true">→</span></a>
  </article>
</SiteLayout>
