---
// Contato — the Wix form schema is fetched SERVER-SIDE so the first paint has the fields.
import SiteLayout from "../layouts/SiteLayout.astro";
import WixFormView from "../components/forms/WixFormView";
import { getForm } from "../wix/forms/forms";
import type { FormDto } from "../wix/forms/types";

const FORM_ID = "d24f23c5-b9a2-4755-89f2-6f245830147a";
let form: FormDto | null = null;
try {
  form = await getForm(FORM_ID);
} catch {
  // Guarded: the island loads the schema itself and shows the real error if it fails again.
}
---
<SiteLayout title="Fale com a redação" description="Dúvidas, sugestões e pedidos de imprensa para A Mulher de Aço / The Woman of Steel">
  <div class="grid gap-12 lg:grid-cols-[2fr_3fr]">
    <div>
      <p class="eyebrow">Contato</p>
      <h1 class="display mb-4 text-[clamp(40px,6vw,88px)] font-extrabold leading-[.9]">Fale com a redação</h1>
      <p class="max-w-md text-muted-foreground">Dúvidas, sugestões e pedidos de imprensa para A Mulher de Aço / The Woman of Steel</p>
      <ul class="mt-8 flex flex-col gap-2 text-sm"><li><a href="mailto:editorial@amulherdeaco.com">editorial@amulherdeaco.com</a></li><li><a href="mailto:amulherdeaco@gmail.com">amulherdeaco@gmail.com</a></li><li><a href="tel:+12032975498">+1 203-297-5498</a></li></ul>
    </div>
    <WixFormView client:load formId={FORM_ID} initialForm={form ?? undefined} submitLabel="Enviar mensagem" />
  </div>
</SiteLayout>
