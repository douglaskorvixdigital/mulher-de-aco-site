---
// Events — items fetched SERVER-SIDE (SEO) from the Wix CMS collection "Events".
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHero from "../components/PageHero.astro";
import CollectionView from "../components/cms/CollectionView";
import { queryItems } from "../wix/cms/items";
import type { CmsPage } from "../wix/cms/types";
const SORT = [{ field: "startDate", direction: "desc" as const }];
const FIELDS = { title: "title", image: "image", date: "startDate", kicker: "location" };
let page: CmsPage = { items: [], hasNext: false, total: null };
try {
  page = await queryItems("Events", { sort: SORT, limit: 12 });
} catch {
  // Guarded: the island renders its own empty/error state.
}
---
<SiteLayout title="Eventos" description="Lançamentos, encontros e eventos organizados pela A Mulher de Aço.">
  <PageHero eyebrow="Eventos" title="Encontros da revista" intro="Lançamentos, encontros e eventos organizados pela A Mulher de Aço."></PageHero>
  <CollectionView client:load collectionId="Events" basePath="/events" fields={FIELDS} emptyText="Nenhum evento agendado no momento." sort={SORT} limit={12} initialItems={page.items} initialHasNext={page.hasNext} />
</SiteLayout>
