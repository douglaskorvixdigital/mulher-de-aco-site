---
// Home — Luxury Editorial Cinematic. Navy ground, metallic gold as a finish, white for air.
// The edition cover is the only photograph the project holds (612×807): it is framed at its
// native height so it stays sharp, layered with a detail crop, never stretched full-bleed.
// Motion: an opening sequence on load, reveals and image parallax on scroll (no pinning, no
// scroll-jacking), and click-driven page transitions from the layout.
import SiteLayout from "../layouts/SiteLayout.astro";
import { queryItems } from "../wix/cms/items";
import { fetchPosts } from "../wix/blog/posts";
import { imgAttrs } from "../wix/media";
import type { CmsItem } from "../wix/cms/types";
import type { PostSummary } from "../wix/blog/types";

let edition: CmsItem | null = null;
let posts: PostSummary[] = [];
try {
  const [eds, feed] = await Promise.all([
    queryItems("Editions", { sort: [{ field: "publishDate", direction: "desc" }], limit: 1 }),
    fetchPosts({ limit: 3 }),
  ]);
  edition = eds.items[0] ?? null;
  posts = feed.posts;
} catch {
  // Guarded: each section has an honest fallback.
}
const editionHref = edition ? `/magazine/${String(edition.slug)}` : "/magazine";
const cover = edition?.cover ? String(edition.cover) : "/images/edicao-01-capa.webp";
const pages = edition?.pages ? Number(edition.pages) : null;
const price = edition?.priceUsd ? Number(edition.priceUsd) : null;
const flipbook = edition?.flipbookUrl ? String(edition.flipbookUrl) : null;

// The founder's list of editorial sections (orientations of 20 Nov 2026).
const EDITORIAS = ["Saúde", "Educação", "Cultura", "Turismo", "Esporte", "Direitos humanos", "Meio ambiente", "Política", "Economia", "Gastronomia"];
// Lines printed on the cover of Edition 01.
const COVER_LINES = ["Leadership without borders", "A strong woman, a brighter world", "From Brazil to the world", "Education, sports, culture, community"];
---
<SiteLayout bleed description="A Mulher de Aço, revista internacional feita por e sobre mulheres que reconstruíram a vida do outro lado da fronteira.">
  <div class="home">

    <!-- OPENING -->
    <section class="hero gutter" aria-labelledby="h-title">
      <span class="hero-line" aria-hidden="true"></span>
      <div class="hero-copy">
        <p class="eyebrow" data-in>Revista internacional · Edição 01 · Novembro 2026</p>
        <h1 id="h-title" class="hero-title">
          <span class="mask"><span data-in-line>A Mulher</span></span>
          <span class="mask"><span data-in-line>de Aço</span></span>
        </h1>
        <p class="hero-en" data-in>The Woman of Steel</p>
        <p class="hero-lede" data-in>Uma revista feita por e sobre mulheres que reconstruíram a vida do outro lado da fronteira.</p>
        <div class="hero-actions" data-in>
          <a class="btn btn-gold" href={editionHref}>Ler a Edição 01 <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn btn-line" href="/partnerships">Anunciar</a>
        </div>
      </div>
      <div class="hero-visual">
        <a class="hero-frame frame" href={editionHref} data-tx="expand" aria-label="Abrir a Edição 01">
          <img src={cover} alt="Capa da Edição 01 de A Mulher de Aço, novembro de 2026" width="612" height="807" fetchpriority="high" data-hero-img />
          <span class="hero-curtain" aria-hidden="true"></span>
        </a>
        <svg class="hero-outline" viewBox="0 0 100 132" preserveAspectRatio="none" aria-hidden="true">
          <defs><linearGradient id="hg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8A6A22"/><stop offset=".45" stop-color="#FFF0C2"/><stop offset="1" stop-color="#B8913A"/></linearGradient></defs>
          <rect x=".5" y=".5" width="99" height="131" fill="none" stroke="url(#hg)" stroke-width=".35" vector-effect="non-scaling-stroke" pathLength="1" />
        </svg>
        <div class="hero-detail frame" aria-hidden="true">
          <img src={cover} alt="" width="612" height="807" data-detail-img />
        </div>
      </div>
      <dl class="hero-facts" data-in>
        {pages && <div><dt class="label">Páginas</dt><dd class="numeral">{pages}</dd></div>}
        {price && <div><dt class="label">Preço</dt><dd class="numeral">US$ {price}</dd></div>}
        <div><dt class="label">Idiomas</dt><dd class="numeral">EN · PT</dd></div>
      </dl>
    </section>

    <!-- MISSION (white) -->
    <section class="mission light gutter" aria-labelledby="m-title">
      <p class="eyebrow">A missão</p>
      <h2 id="m-title" class="mission-quote" data-words>Nasce da história de uma mulher, mas existe para dar visibilidade às histórias de muitas mulheres.</h2>
      <p class="label mission-sign">Maria Barile · Fundadora e diretora</p>
    </section>

    <!-- EDITION -->
    <section class="edition gutter" aria-labelledby="e-title">
      <a class="ed-frame frame" href={editionHref} data-tx="expand" data-mask aria-label="Abrir a Edição 01">
        <img src={cover} alt="Capa da Edição 01 de A Mulher de Aço" width="612" height="807" loading="lazy" data-parallax />
      </a>
      <div class="ed-copy">
        <p class="numeral ed-num" aria-hidden="true">01</p>
        <p class="eyebrow" data-reveal>{edition?.edition ? "Edição internacional" : "Edição"} · Novembro 2026</p>
        <h2 id="e-title" class="sec-title" data-reveal>A primeira edição</h2>
        <p class="ed-lede" data-reveal>{edition?.slogan ? String(edition.slogan) : "Beyond Borders, Beyond Limits"}</p>
        <ol class="ed-lines">
          {COVER_LINES.map((l, i) => (
            <li data-reveal><span class="numeral">{String(i + 1).padStart(2, "0")}</span><span>{l}</span></li>
          ))}
        </ol>
        <div class="ed-actions" data-reveal>
          {flipbook && <a class="btn btn-gold" href={flipbook} target="_blank" rel="noopener">Folhear a edição <span class="arr" aria-hidden="true">↗</span><span class="sr-only"> (abre em nova aba)</span></a>}
          <a class="btn btn-line" href="/shop">Comprar</a>
        </div>
      </div>
    </section>

    <!-- EDITORIAS -->
    <section class="editorias gutter" aria-labelledby="ed-title">
      <div class="sec-head">
        <h2 id="ed-title" class="sec-title" data-reveal>Editorias</h2>
        <p class="sec-note" data-reveal>Reportagens por tema, escritas a partir da experiência de quem vive entre dois países.</p>
      </div>
      <ul class="index">
        {EDITORIAS.map((name, i) => (
          <li data-reveal>
            <a href="/blog">
              <span class="numeral">{String(i + 1).padStart(2, "0")}</span>
              <span class="index-name">{name}</span>
              <span class="index-arr" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- REPORTING (white) -->
    <section class="reporting light gutter" aria-labelledby="r-title">
      <div class="sec-head">
        <h2 id="r-title" class="sec-title" data-reveal>Reportagens</h2>
        <a class="link-draw label" href="/blog">Todas as reportagens</a>
      </div>
      {posts.length === 0
        ? <p class="sec-note">As primeiras reportagens estão a caminho.</p>
        : <ul class="cards">
            {posts.map((p, i) => {
              const img = imgAttrs(p.coverUrl, "(min-width: 900px) 33vw, 100vw", 0.75);
              return (
                <li data-reveal>
                  <a href={`/blog/${p.slug}`} class="card" data-tx={"src" in img ? "expand" : undefined}>
                    <span class="card-frame frame" data-mask>
                      {"src" in img
                        ? <img {...img} alt="" />
                        : <span class="card-empty"><span class="numeral">{String(i + 1).padStart(2, "0")}</span><span class="label">Imagem em breve</span></span>}
                    </span>
                    {p.dateLabel && <span class="label card-meta">{p.dateLabel}</span>}
                    <span class="card-title">{p.title}</span>
                    {p.excerpt && <span class="card-x">{p.excerpt}</span>}
                  </a>
                </li>
              );
            })}
          </ul>}
    </section>

    <!-- THE POWER OF M -->
    <section class="power gutter" aria-labelledby="p-title">
      <svg class="power-m" viewBox="0 0 120 100" aria-hidden="true">
        <defs><linearGradient id="pm" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8A6A22"/><stop offset=".5" stop-color="#FFF0C2"/><stop offset="1" stop-color="#B8913A"/></linearGradient></defs>
        <path d="M8 92 V10 L60 70 L112 10 V92" fill="none" stroke="url(#pm)" stroke-width=".6" pathLength="1" data-draw />
      </svg>
      <div class="power-copy">
        <p class="eyebrow" data-reveal>Capítulo · The Power of M</p>
        <h2 id="p-title" class="sec-title" data-reveal>Uma mulher forte, um mundo mais luminoso</h2>
        <p class="sec-note" data-reveal>Liderança sem fronteiras, comunidade e a jornada de quem saiu do Brasil para o mundo.</p>
        <a class="btn btn-line" href="/about" data-reveal>Quem somos <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- PARTNERS (white) -->
    <section class="partners light gutter" aria-labelledby="pt-title">
      <span class="rule" aria-hidden="true"></span>
      <div class="pt-grid">
        <h2 id="pt-title" class="sec-title pt-title" data-reveal>Sua marca diante de mulheres que atravessam fronteiras</h2>
        <div class="pt-side" data-reveal>
          <p>Anúncios, patrocínios e parcerias em uma revista bilíngue lida nos Estados Unidos e fora deles.</p>
          <a class="btn btn-gold" href="/partnerships">Falar com a equipe comercial <span class="arr" aria-hidden="true">→</span></a>
          <p class="label pt-mail select-all">editorial@amulherdeaco.com</p>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>

<style is:global>
  .home section { position: relative; }
  .sec-title { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(36px, 4.6vw, 76px); line-height: 1; letter-spacing: -.04em; }
  .sec-note { margin: 0; max-width: 46ch; color: var(--color-muted-foreground); }
  .sec-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 56px; }
  .mask { display: block; overflow: hidden; padding-bottom: .08em; margin-bottom: -.08em; }
  .mask > span { display: block; }

  /* OPENING */
  .hero { min-height: 100svh; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); grid-template-rows: 1fr auto; column-gap: 5vw; padding-top: calc(env(safe-area-inset-top, 0px) + 120px); padding-bottom: 40px; overflow: hidden; }
  .hero-line { position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: var(--gold-metal); transform: scaleX(0); transform-origin: left; opacity: 0; pointer-events: none; }
  .hero-copy { align-self: center; display: grid; gap: 22px; position: relative; z-index: 2; }
  .hero-title { margin: 0; font-weight: 500; font-size: clamp(56px, 8.4vw, 148px); line-height: .92; letter-spacing: -.05em; }
  .hero-title .mask:last-child span { color: transparent; background: var(--gold-metal); background-size: 200% 100%; -webkit-background-clip: text; background-clip: text; }
  .hero-en { margin: -6px 0 0; font-family: var(--font-serif); font-size: clamp(22px, 2vw, 30px); color: var(--color-mist); }
  .hero-lede { margin: 0; max-width: 38ch; font-size: clamp(17px, 1.35vw, 20px); color: #DCE3F0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .hero-visual { position: relative; align-self: center; justify-self: end; width: min(100%, calc(min(78svh, 807px) * 612 / 807)); aspect-ratio: 612 / 807; }
  .hero-frame { position: absolute; inset: 0; display: block; }
  .hero-frame img { transform-origin: 50% 40%; }
  .hero-curtain { position: absolute; inset: 0; background: var(--color-navy); transform-origin: top; }
  .hero-outline { position: absolute; inset: -14px; width: calc(100% + 28px); height: calc(100% + 28px); overflow: visible; pointer-events: none; }
  .hero-outline rect { stroke-dasharray: 1; stroke-dashoffset: 0; }
  .hero-detail { position: absolute; width: 38%; aspect-ratio: 1; left: -22%; bottom: 9%; box-shadow: 0 30px 80px -30px #000; outline: 1px solid rgba(215, 181, 101, .5); outline-offset: 6px; }
  .hero-detail img { width: 100%; height: 100%; object-fit: cover; object-position: 63% 26%; transform: scale(2.2); transform-origin: 63% 26%; }
  .hero-facts { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 40px; margin: 48px 0 0; padding-top: 20px; border-top: 1px solid var(--color-border); position: relative; z-index: 2; }
  .hero-facts dt { color: var(--color-mist); }
  .hero-facts dd { margin: 6px 0 0; font-size: 30px; }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; grid-template-rows: auto auto auto; padding-top: calc(env(safe-area-inset-top, 0px) + 100px); row-gap: 40px; }
    .hero-visual { justify-self: center; width: min(78vw, 420px); order: -1; }
    .hero-detail { left: auto; right: -10%; bottom: -8%; width: 40%; }
    .hero-facts { margin-top: 8px; gap: 28px; }
  }

  /* MISSION */
  .mission { padding-block: 18vh; display: grid; gap: 32px; }
  .mission-quote { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(34px, 5vw, 84px); line-height: 1.04; letter-spacing: -.04em; max-width: 22ch; }
  .mission-quote .w { opacity: .14; transition: opacity 400ms var(--ease-out); }
  .mission-quote .w.on { opacity: 1; }
  .mission-sign { color: var(--color-muted-foreground); }

  /* EDITION */
  .edition { padding-block: 16vh; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 7vw; align-items: center; }
  .ed-frame { display: block; aspect-ratio: 612 / 807; width: min(100%, calc(min(82svh, 807px) * 612 / 807)); justify-self: center; }
  .ed-frame img { transform: scale(1.12); }
  .ed-copy { display: grid; gap: 20px; }
  .ed-num { margin: 0 0 -10px; font-size: clamp(96px, 12vw, 200px); color: transparent; -webkit-text-stroke: 1px var(--color-gold); }
  .ed-lede { margin: 0; font-family: var(--font-serif); font-size: clamp(24px, 2.2vw, 34px); color: var(--color-gold-light); }
  .ed-lines { list-style: none; margin: 8px 0; padding: 0; border-top: 1px solid var(--color-border); }
  .ed-lines li { display: grid; grid-template-columns: 48px 1fr; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--color-border); }
  .ed-lines .numeral { color: var(--color-gold); font-size: 20px; }
  .ed-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  @media (max-width: 900px) { .edition { grid-template-columns: 1fr; } .ed-frame { width: min(80vw, 440px); } }

  /* EDITORIAS */
  .editorias { padding-block: 14vh; background: var(--color-navy-2); }
  .index { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 5vw; border-top: 1px solid var(--color-border); }
  .index li { border-bottom: 1px solid var(--color-border); }
  .index a { position: relative; display: grid; grid-template-columns: 56px 1fr auto; align-items: baseline; gap: 16px; padding: 22px 0; text-decoration: none; }
  .index a::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: var(--gold-metal); transform: scaleX(0); transform-origin: left; transition: transform var(--t-cine) var(--ease-out); }
  .index a:hover::after, .index a:focus-visible::after { transform: scaleX(1); }
  .index .numeral { color: var(--color-gold); font-size: 22px; }
  .index-name { font-family: var(--font-display); font-weight: 400; font-size: clamp(26px, 2.6vw, 42px); letter-spacing: -.03em; transition: transform var(--t-std) var(--ease-out); }
  .index a:hover .index-name, .index a:focus-visible .index-name { transform: translateX(12px); }
  .index-arr { color: var(--color-gold); opacity: 0; transform: translateX(-10px); transition: opacity var(--t-std) var(--ease-out), transform var(--t-std) var(--ease-out); }
  .index a:hover .index-arr, .index a:focus-visible .index-arr { opacity: 1; transform: none; }
  @media (max-width: 760px) { .index { grid-template-columns: 1fr; } .sec-head { flex-direction: column; align-items: flex-start; } }

  /* REPORTING */
  .reporting { padding-block: 14vh; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .card { display: grid; gap: 14px; text-decoration: none; color: inherit; }
  .card-frame { display: block; aspect-ratio: 4 / 5; }
  .card-frame img { transition: transform 1.2s var(--ease-out); }
  .card:hover .card-frame img { transform: scale(1.05); }
  .card-empty { position: absolute; inset: 0; display: grid; align-content: space-between; padding: 22px; color: var(--color-white); background: var(--color-navy); }
  .card-empty .numeral { font-size: 64px; color: transparent; -webkit-text-stroke: 1px var(--color-gold); transition: transform var(--t-cine) var(--ease-out); }
  .card:hover .card-empty .numeral { transform: translateY(-6px); }
  .card-empty .label { color: var(--color-mist); }
  .card-meta { color: var(--color-gold-deep); }
  .card-title { font-family: var(--font-display); font-weight: 500; font-size: 24px; line-height: 1.15; letter-spacing: -.02em; background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size var(--t-cine) var(--ease-out); }
  .card:hover .card-title { background-size: 100% 1px; }
  .card-x { color: var(--color-muted-foreground); }
  @media (max-width: 900px) { .cards { grid-template-columns: 1fr; } .card-frame { aspect-ratio: 16 / 10; } }

  /* POWER OF M */
  .power { padding-block: 16vh; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 6vw; align-items: center; overflow: hidden; }
  .power-m { width: 100%; max-width: 620px; height: auto; overflow: visible; }
  .power-m path { stroke-dasharray: 1; stroke-dashoffset: 0; }
  .power-copy { display: grid; gap: 22px; justify-items: start; }
  @media (max-width: 900px) { .power { grid-template-columns: 1fr; } .power-m { max-width: 320px; } }

  /* PARTNERS */
  .partners { padding-block: 0 16vh; }
  .partners .rule { margin-bottom: 14vh; }
  .pt-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 6vw; align-items: end; }
  .pt-title { max-width: 16ch; }
  .pt-side { display: grid; gap: 22px; justify-items: start; }
  .pt-side p { margin: 0; color: var(--color-muted-foreground); }
  .pt-mail { color: var(--color-gold-deep); }
  @media (max-width: 900px) { .pt-grid { grid-template-columns: 1fr; } }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // mission words (the sentence stays one readable heading; spans only carry opacity)
  const quote = document.querySelector<HTMLElement>("[data-words]");
  const words: HTMLElement[] = [];
  if (quote) {
    const text = quote.textContent ?? "";
    quote.setAttribute("aria-label", text.trim());
    quote.textContent = "";
    text.trim().split(/\s+/).forEach((w, i, all) => {
      const s = document.createElement("span");
      s.className = "w"; s.textContent = w; s.setAttribute("aria-hidden", "true");
      quote.appendChild(s);
      if (i < all.length - 1) quote.appendChild(document.createTextNode(" "));
      words.push(s);
    });
  }

  if (reduce) {
    words.forEach((w) => w.classList.add("on"));
  } else {
    gsap.registerPlugin(ScrollTrigger);
    gsap.ticker.lagSmoothing(0);
    // when the page was reached through a transition, the opening waits for the curtain to lift
    const delay = document.documentElement.classList.contains("tx-cover") ? 0.7 : 0.1;

    // OPENING: a gold line crosses the screen, the curtain over the cover lifts while the picture
    // settles, the name rises through its mask, the rest follows in sequence.
    const tl = gsap.timeline({ delay, defaults: { ease: "expo.out" } });
    tl.set(".hero [data-in], .hero-facts", { autoAlpha: 0, y: 22 })
      .set("[data-in-line]", { yPercent: 110 })
      .set(".hero-detail", { autoAlpha: 0, y: 40 })
      .set(".hero-outline rect", { strokeDashoffset: 1 })
      .to(".hero-line", { opacity: 1, scaleX: 1, duration: 0.9, ease: "power3.inOut" }, 0)
      .to(".hero-line", { opacity: 0, duration: 0.6, ease: "power2.out" }, 0.95)
      .to(".hero-curtain", { scaleY: 0, duration: 1.2, ease: "power4.inOut" }, 0.55)
      .fromTo("[data-hero-img]", { scale: 1.22 }, { scale: 1, duration: 2.2, ease: "power3.out" }, 0.55)
      .to(".hero-outline rect", { strokeDashoffset: 0, duration: 1.6, ease: "power2.inOut" }, 1.1)
      .to("[data-in-line]", { yPercent: 0, duration: 1.2, stagger: 0.1 }, 0.75)
      .to(".hero [data-in]", { autoAlpha: 1, y: 0, duration: 1, stagger: 0.08 }, 1.05)
      .to(".hero-detail", { autoAlpha: 1, y: 0, duration: 1.3 }, 1.4)
      .to(".hero-facts", { autoAlpha: 1, y: 0, duration: 1 }, 1.6);

    // the detail crop drifts slower than the cover as the opening leaves (image parallax only).
    // GSAP owns this transform, so the crop's zoom is set here too (CSS keeps it for reduced motion).
    gsap.set(".hero-detail img", { scale: 2.2, transformOrigin: "63% 26%" });
    gsap.to(".hero-detail img", { yPercent: 14, ease: "none", scrollTrigger: { trigger: ".hero", start: "top top", end: "bottom top", scrub: true } });
    gsap.to(".hero-frame", { yPercent: -6, ease: "none", scrollTrigger: { trigger: ".hero", start: "top top", end: "bottom top", scrub: true } });

    // MISSION: the words arrive as the reader reaches them (no pinning)
    if (quote) {
      ScrollTrigger.create({
        trigger: quote, start: "top 80%", end: "bottom 45%", scrub: true,
        onUpdate: (s) => { const n = Math.round(s.progress * words.length); words.forEach((w, i) => w.classList.toggle("on", i < n)); },
      });
    }

    // reveals: each block rises once when it enters
    gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((el) => {
      gsap.from(el, { y: 36, autoAlpha: 0, duration: 1.1, ease: "expo.out", scrollTrigger: { trigger: el, start: "top 88%", once: true } });
    });

    // masked frames open from the bottom edge
    gsap.utils.toArray<HTMLElement>("[data-mask]").forEach((el) => {
      gsap.fromTo(el, { clipPath: "inset(100% 0% 0% 0%)" }, { clipPath: "inset(0% 0% 0% 0%)", duration: 1.4, ease: "power4.inOut", scrollTrigger: { trigger: el, start: "top 85%", once: true } });
    });

    // image parallax inside its frame
    gsap.utils.toArray<HTMLElement>("[data-parallax]").forEach((img) => {
      gsap.fromTo(img, { yPercent: -6 }, { yPercent: 6, ease: "none", scrollTrigger: { trigger: img.parentElement, start: "top bottom", end: "bottom top", scrub: true } });
    });

    // the M is drawn by the scroll
    const m = document.querySelector<SVGPathElement>("[data-draw]");
    if (m) gsap.fromTo(m, { strokeDashoffset: 1 }, { strokeDashoffset: 0, ease: "none", scrollTrigger: { trigger: ".power", start: "top 75%", end: "center 45%", scrub: true } });
  }
</script>
