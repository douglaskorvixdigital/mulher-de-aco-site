---
// The Magazine — items fetched SERVER-SIDE (SEO) from the Wix CMS collection "Editions".
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHero from "../components/PageHero.astro";
import CollectionView from "../components/cms/CollectionView";
import { queryItems } from "../wix/cms/items";
import type { CmsPage } from "../wix/cms/types";
const SORT = [{ field: "publishDate", direction: "desc" as const }];
const FIELDS = { title: "issueLabel", image: "cover", date: "publishDate", kicker: "edition", summary: "slogan" };
let page: CmsPage = { items: [], hasNext: false, total: null };
try {
  page = await queryItems("Editions", { sort: SORT, limit: 12 });
} catch {
  // Guarded: the island renders its own empty/error state.
}
---
<SiteLayout title="A Revista" description="A revista trimestral e internacional sobre mulheres que reconstruíram a vida do outro lado da fronteira.">
  <PageHero eyebrow="A Revista" title="Todas as edições" intro="A revista trimestral e internacional sobre mulheres que reconstruíram a vida do outro lado da fronteira."></PageHero>
  <CollectionView client:load collectionId="Editions" basePath="/magazine" fields={FIELDS} emptyText="Nenhuma edição publicada ainda." sort={SORT} limit={12} initialItems={page.items} initialHasNext={page.hasNext} />
</SiteLayout>
