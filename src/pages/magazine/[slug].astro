---
// One edition — the premium editorial page. The cover is the destination of the Home's "expand"
// transition (data-tx-target): the picture the visitor clicked settles here. Then the edition's
// own headlines, the facts, the actions; a white chapter for The Power of M.
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getItemBy } from "../../wix/cms/items";
import { formatDate } from "../../wix/cms/items-core";
import type { CmsItem } from "../../wix/cms/types";

let item: CmsItem | null = null;
try {
  item = await getItemBy("Editions", "slug", Astro.params.slug!);
} catch {
  // Guarded: an unhandled SSR throw truncates the response mid-stream.
}
if (!item) return new Response(null, { status: 404 });

const title = String(item.title ?? "");
const issue = String(item.issueLabel ?? "").replace("Year", "Ano").replace("Edition", "Edição");
const kind = String(item.edition ?? "").replace("International edition", "Edição internacional");
const cover = item.cover ? String(item.cover) : "/images/edicao-01-capa.webp";
const summary = item.summary ? String(item.summary) : "";
const isPlaceholder = summary.includes("[Placeholder]");
const credits = item.credits ? String(item.credits).replace("Proofreading:", "Revisão:") : "";
const LINES = [
  { t: "Leadership without borders", s: "Turning challenges into global opportunities" },
  { t: "A strong woman, a brighter world", s: "Inspiring people, connecting cultures, building opportunities" },
  { t: "From Brazil to the world", s: "A journey of faith, resilience and purpose" },
  { t: "Education, sports, culture, community", s: "Real stories, real impact, a global vision" },
];
---
<SiteLayout title={issue || title} description={`${title}. ${issue}. ${item.slogan ?? ""}`} bleed>
  <section class="ed gutter" aria-labelledby="ed-h">
    <div class="ed-top">
      <a href="/magazine" class="label link-draw">← Todas as edições</a>
      {item.publishDate && <p class="label ed-date">{formatDate(item.publishDate, "pt-BR", { month: "long", year: "numeric" })}</p>}
    </div>
    <div class="ed-grid">
      <div class="ed-cover-wrap">
        <div class="ed-cover frame" data-tx-target>
          <img src={cover} alt={`Capa de ${title}, ${issue}`} width="612" height="807" fetchpriority="high" />
        </div>
        <span class="ed-outline" aria-hidden="true"></span>
      </div>
      <div class="ed-copy">
        {kind && <p class="eyebrow ed-fade" style="--d:.1s">{kind}</p>}
        <h1 id="ed-h" class="ed-title"><span class="ed-mask"><span>{title}</span></span></h1>
        {issue && <p class="numeral ed-issue ed-fade" style="--d:.45s">{issue}</p>}
        {item.slogan && <p class="ed-slogan ed-fade" style="--d:.55s">{String(item.slogan)}</p>}
        <dl class="ed-facts ed-fade" style="--d:.65s">
          {item.pages && <div><dt class="label">Páginas</dt><dd class="numeral">{String(item.pages)}</dd></div>}
          {item.priceUsd && <div><dt class="label">Preço</dt><dd class="numeral">US$ {String(item.priceUsd)}</dd></div>}
          <div><dt class="label">Idiomas</dt><dd class="numeral">EN · PT</dd></div>
        </dl>
        <div class="ed-actions ed-fade" style="--d:.75s">
          {item.flipbookUrl && <a href={String(item.flipbookUrl)} target="_blank" rel="noopener" class="btn btn-gold">Folhear a edição <span class="arr" aria-hidden="true">↗</span><span class="sr-only"> (abre em nova aba)</span></a>}
          <a href="/shop" class="btn btn-line">Comprar na loja</a>
        </div>
      </div>
    </div>
  </section>

  <section class="pm light gutter" aria-labelledby="pm-h">
    <div class="pm-head">
      <p class="eyebrow">The Power of M · Nesta edição</p>
      <h2 id="pm-h" class="pm-title">As histórias da capa</h2>
    </div>
    <ol class="pm-list">
      {LINES.map((l, i) => (
        <li>
          <span class="numeral pm-n">{String(i + 1).padStart(2, "0")}</span>
          <span class="pm-t">{l.t}</span>
          <span class="pm-s">{l.s}</span>
        </li>
      ))}
    </ol>
    <div class={`pm-summary ${isPlaceholder ? "ph" : ""}`} set:html={summary.replace("[Placeholder] Edition summary pending approval by the editorial team.", "[Texto provisório] Resumo da edição aguardando aprovação da redação.")} />
    {credits && <p class="label pm-credits">{credits}</p>}
  </section>
</SiteLayout>

<style>
  .ed { min-height: 100svh; padding-top: calc(env(safe-area-inset-top, 0px) + 110px); padding-bottom: 12vh; display: grid; gap: 5vh; align-content: start; }
  .ed-top { display: flex; justify-content: space-between; gap: 16px; }
  .ed-top a { color: var(--color-gold); }
  .ed-date { color: var(--color-mist); }
  .ed-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 7vw; align-items: center; }
  .ed-cover-wrap { position: relative; justify-self: center; width: min(100%, calc(min(80svh, 807px) * 612 / 807)); aspect-ratio: 612 / 807; }
  .ed-cover { position: absolute; inset: 0; box-shadow: 0 50px 140px -40px #000; animation: ed-open 1.4s var(--ease-cine) both .2s; }
  .ed-outline { position: absolute; inset: -14px; border: 1px solid rgba(215, 181, 101, .55); animation: ed-fade 1.2s var(--ease-out) both .9s; pointer-events: none; }
  .ed-copy { display: grid; gap: 20px; }
  .ed-title { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(40px, 5vw, 84px); line-height: 1; letter-spacing: -.045em; }
  .ed-mask { display: block; overflow: hidden; padding-bottom: .1em; margin-bottom: -.1em; }
  .ed-mask > span { display: block; animation: ed-rise 1.2s var(--ease-out) both .25s; }
  .ed-issue { margin: 0; font-size: clamp(26px, 2.4vw, 38px); color: var(--color-gold-light); }
  .ed-slogan { margin: 0; color: var(--color-mist); font-size: 18px; letter-spacing: .04em; }
  .ed-facts { display: flex; flex-wrap: wrap; gap: 40px; margin: 8px 0; padding: 20px 0; border-block: 1px solid var(--color-border); }
  .ed-facts dt { color: var(--color-mist); }
  .ed-facts dd { margin: 6px 0 0; font-size: 30px; }
  .ed-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .ed-fade { animation: ed-fade 1s var(--ease-out) both var(--d, .3s); }
  :global(html.tx-cover) .ed-fade, :global(html.tx-cover) .ed-mask > span { animation-delay: 1s; }
  :global(html.tx-cover) .ed-cover { animation: none; }
  @keyframes ed-open { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes ed-rise { from { transform: translateY(108%); } to { transform: none; } }
  @keyframes ed-fade { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

  .pm { padding-block: 16vh; display: grid; gap: 48px; }
  .pm-head { display: grid; gap: 16px; }
  .pm-title { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(36px, 4.6vw, 76px); letter-spacing: -.04em; line-height: 1; }
  .pm-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-border); }
  .pm-list li { display: grid; grid-template-columns: 72px minmax(0, 1.3fr) minmax(0, 1fr); gap: 24px; align-items: baseline; padding: 28px 0; border-bottom: 1px solid var(--color-border); }
  .pm-n { font-size: 30px; color: var(--color-gold-deep); }
  .pm-t { font-family: var(--font-display); font-weight: 500; font-size: clamp(24px, 2.4vw, 40px); letter-spacing: -.03em; line-height: 1.1; }
  .pm-s { color: var(--color-muted-foreground); }
  .pm-summary { max-width: 62ch; font-size: 20px; }
  .pm-summary.ph { font-size: 16px; color: var(--color-muted-foreground); border: 1px dashed var(--color-border); padding: 16px; }
  .pm-credits { color: var(--color-muted-foreground); }
  @media (max-width: 900px) {
    .ed-grid { grid-template-columns: 1fr; }
    .ed-cover-wrap { width: min(80vw, 440px); }
    .pm-list li { grid-template-columns: 48px 1fr; }
    .pm-s { grid-column: 2; }
  }
</style>
