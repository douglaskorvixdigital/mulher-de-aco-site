---
// Parcerias e anúncios — the Wix form schema is fetched SERVER-SIDE so the first paint has the fields.
import SiteLayout from "../layouts/SiteLayout.astro";
import WixFormView from "../components/forms/WixFormView";
import { getForm } from "../wix/forms/forms";
import type { FormDto } from "../wix/forms/types";

const FORM_ID = "aa37df77-7ac8-4cd0-9b88-fc8ac5b7bdd1";
let form: FormDto | null = null;
try {
  form = await getForm(FORM_ID);
} catch {
  // Guarded: the island loads the schema itself and shows the real error if it fails again.
}
---
<SiteLayout title="Anuncie na revista ou seja parceiro" description="Fale com mulheres imigrantes nos Estados Unidos e fora deles por meio de uma revista trimestral, bilíngue e internacional. Conte sobre sua marca e nossa equipe entra em contato">
  <div class="grid gap-12 lg:grid-cols-[2fr_3fr]">
    <div>
      <p class="eyebrow">Parcerias e anúncios</p>
      <h1 class="display mb-4 text-[clamp(40px,6vw,88px)] font-extrabold leading-[.9]">Anuncie na revista ou seja parceiro</h1>
      <p class="max-w-md text-muted-foreground">Fale com mulheres imigrantes nos Estados Unidos e fora deles por meio de uma revista trimestral, bilíngue e internacional. Conte sobre sua marca e nossa equipe entra em contato</p>
      <p class="mt-8 rounded-lg border border-dashed border-border p-4 text-sm text-muted-foreground">[Texto provisório] O mídia kit e a tabela de anúncios serão publicados aqui após aprovação.</p>
    </div>
    <WixFormView client:load formId={FORM_ID} initialForm={form ?? undefined} submitLabel="Enviar pedido" />
  </div>
</SiteLayout>
