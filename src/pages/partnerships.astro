---
// Partnerships &amp; Advertising — the Wix form schema is fetched SERVER-SIDE so the first paint has the fields.
import SiteLayout from "../layouts/SiteLayout.astro";
import WixFormView from "../components/forms/WixFormView";
import { getForm } from "../wix/forms/forms";
import type { FormDto } from "../wix/forms/types";

const FORM_ID = "aa37df77-7ac8-4cd0-9b88-fc8ac5b7bdd1";
let form: FormDto | null = null;
try {
  form = await getForm(FORM_ID);
} catch {
  // Guarded: the island loads the schema itself and shows the real error if it fails again.
}
---
<SiteLayout title="Advertise in the magazine or partner with us" description="Reach immigrant women in the U.S. and abroad through a quarterly, bilingual international magazine. Tell us about your brand and our team will get in touch">
  <div class="grid gap-12 lg:grid-cols-[2fr_3fr]">
    <div>
      <p class="eyebrow">Partnerships &amp; Advertising</p>
      <h1 class="mb-4 font-serif text-3xl font-semibold">Advertise in the magazine or partner with us</h1>
      <p class="max-w-md text-muted-foreground">Reach immigrant women in the U.S. and abroad through a quarterly, bilingual international magazine. Tell us about your brand and our team will get in touch</p>
      <p class="mt-8 rounded-lg border border-dashed border-border p-4 text-sm text-muted-foreground">[Placeholder] Media kit and advertising rates will be published here after approval.</p>
    </div>
    <WixFormView client:load formId={FORM_ID} initialForm={form ?? undefined} submitLabel="Send inquiry" />
  </div>
</SiteLayout>
