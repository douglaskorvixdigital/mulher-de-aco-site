---
// Envie sua história — the Wix form schema is fetched SERVER-SIDE so the first paint has the fields.
import SiteLayout from "../layouts/SiteLayout.astro";
import WixFormView from "../components/forms/WixFormView";
import { getForm } from "../wix/forms/forms";
import type { FormDto } from "../wix/forms/types";

const FORM_ID = "6d9763ea-3500-4e0b-9613-4b27414b57b2";
let form: FormDto | null = null;
try {
  form = await getForm(FORM_ID);
} catch {
  // Guarded: the island loads the schema itself and shows the real error if it fails again.
}
---
<SiteLayout title="Conte a história de uma mulher de aço" description="A sua história ou a de outra mulher imigrante. A redação lê cada envio, e nada é publicado sem aprovação">
  <div class="grid gap-12 lg:grid-cols-[2fr_3fr]">
    <div>
      <p class="eyebrow">Envie sua história</p>
      <h1 class="mb-6 font-[family-name:var(--font-display)] text-[clamp(40px,5.4vw,88px)] font-medium leading-none tracking-[-.045em]">Conte a história de uma mulher de aço</h1>
      <p class="max-w-md text-muted-foreground">A sua história ou a de outra mulher imigrante. A redação lê cada envio, e nada é publicado sem aprovação</p>
      
    </div>
    <WixFormView client:load formId={FORM_ID} initialForm={form ?? undefined} submitLabel="Enviar história" />
  </div>
</SiteLayout>
