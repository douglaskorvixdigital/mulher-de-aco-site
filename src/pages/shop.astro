---
// Shop — products and categories fetched SERVER-SIDE (SEO), filtered live on the client.
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHero from "../components/PageHero.astro";
import ShopView from "../components/storefront/ShopView";
import { fetchProducts, fetchCategories } from "../wix/storefront/catalog";
import type { Category, ProductSummary } from "../wix/storefront/types";

let products: ProductSummary[] = [];
let categories: Category[] = [];
try {
  [products, categories] = await Promise.all([fetchProducts({ limit: 24 }), fetchCategories()]);
} catch {
  // Guarded: the island renders its own empty/error state.
}
---
<SiteLayout title="Loja" description="Edições da revista e publicações da A Mulher de Aço.">
  <PageHero eyebrow="Loja" title="Edições e livros" intro="Edições da revista e publicações da A Mulher de Aço."></PageHero>
  <ShopView client:load initialProducts={products} initialCategories={categories} />
</SiteLayout>
