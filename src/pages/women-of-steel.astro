---
// Women of Steel — items fetched SERVER-SIDE (SEO) from the Wix CMS collection "WomenOfSteel".
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHero from "../components/PageHero.astro";
import CollectionView from "../components/cms/CollectionView";
import { queryItems } from "../wix/cms/items";
import type { CmsPage } from "../wix/cms/types";
const SORT = [{ field: "publishDate", direction: "desc" as const }];
const FIELDS = { title: "name", image: "photo", kicker: "country", summary: "summary" };
let page: CmsPage = { items: [], hasNext: false, total: null };
try {
  page = await queryItems("WomenOfSteel", { sort: SORT, limit: 12 });
} catch {
  // Guarded: the island renders its own empty/error state.
}
---
<SiteLayout title="Mulheres de Aço" description="Perfis de mulheres imigrantes, publicados com a aprovação de cada uma.">
  <PageHero eyebrow="Mulheres de Aço" title="Histórias que atravessam fronteiras" intro="Perfis de mulheres imigrantes, publicados com a aprovação de cada uma.">
    <a href="/share-your-story" class="btn btn-line self-start">Envie sua história <span class="arr" aria-hidden="true">→</span></a>
  </PageHero>
  <CollectionView client:load collectionId="WomenOfSteel" basePath="/women-of-steel" fields={FIELDS} emptyText="Os primeiros perfis estão a caminho." sort={SORT} limit={12} initialItems={page.items} initialHasNext={page.hasNext} />
</SiteLayout>
